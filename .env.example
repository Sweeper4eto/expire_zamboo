DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-long-random-string"
CRON_SECRET="change-me-cron-secret"

# Push notifications (run: npm run vapid)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Optional: force secure session cookies (required for HTTPS / LAN)
# SESSION_COOKIE_SECURE=true
# Public site origin for canonical URLs, sitemap, Open Graph (production):
# NEXT_PUBLIC_APP_URL=https://expire365.com
# LAN / local HTTPS example:
# NEXT_PUBLIC_APP_URL=https://192.168.1.100:3443
# Google Search Console HTML tag verification code (optional):
# GOOGLE_SITE_VERIFICATION=

# Document OCR for Add document (Gemini recommended)
# Prefer full Flash (not lite) — lite models shift rows/dates often.
# GEMINI_API_KEY=
# DOCUMENT_AI_MODEL=gemini-3.5-flash
# OCR_DEBUG=1
# Or OpenAI-compatible:
# OPENAI_API_KEY=
# DOCUMENT_AI_PROVIDER=openai
# DOCUMENT_AI_MODEL=gpt-4o-mini

# Zamboo (Mistral) integration — test catalog / document send
# ZAMBOO_API_BASE=https://sweps.zamboo.bg
# ZAMBOO_API_KEY=
# ZAMBOO_DB_GUID=
